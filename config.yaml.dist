# KSeF Watcher — configuration template.
#
# Copy this file to `config.yaml` next to the `ksef-watcher` binary (or to
# /etc/ksef-watcher/config.yaml) and fill in real values. Hot-reloaded — edit it in place while
# the daemon is running and changes apply automatically; an invalid edit is rejected and logged,
# the last valid configuration keeps running.

version: 1 # schema version — currently only 1 is supported

# Environment every subject uses unless it sets its own `environment` below (OQ-9).
# One of: test | demo | prod. New subjects default here on purpose — switching one to prod
# is a deliberate, visible act, not an accident.
defaultEnvironment: test

subjects:
  # Add one entry per company (NIP) you want watched. At least one is required.
  - nip: "0000000000" # the company's NIP, with a valid checksum

    intervalMinutes: 60 # how often to poll this subject. Minimum 15 (MF recommendation), maximum 10080 (7 days)

    # The KSeF token generated for this subject. Either a literal value, or a reference to an
    # environment variable so the token itself never has to live in this file:
    #   ksefToken: "${KSEF_TOKEN_SUBJECT_1}"
    ksefToken: "..."

    # Optional — overrides defaultEnvironment above for this one subject.
    # environment: test

    # Optional — how invoice amounts are shown in notifications. One of: brutto | netto.
    # Defaults to brutto.
    # amountDisplay: brutto

    # Exactly one channel per subject (OQ-12). Discord is the only supported type in V1.
    channels:
      - type: discord
        webhookUrl: "https://discord.com/api/webhooks/..."

  # - nip: "1111111111"
  #   intervalMinutes: 30
  #   ksefToken: "${KSEF_TOKEN_SUBJECT_2}"
  #   environment: prod
  #   channels:
  #     - type: discord
  #       webhookUrl: "https://discord.com/api/webhooks/..."
